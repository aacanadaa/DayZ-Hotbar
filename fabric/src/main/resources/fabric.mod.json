{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		{
			"name": "${mod_author}",
			"contact": {
				"homepage": "https://modrinth.com/user/${mod_author}"
			}
		}
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/${mod_id_slug}",
		"sources": "${mod_sources}",
		"issues": "${mod_issues}"
	},
	"license": "${mod_license}",
	"icon": "assets/dayz_hotbar/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.suoim.dayzhotbar.fabric.client.DayZHotbarFabricClient"
		]
	},
	"mixins": [
		{
			"config": "dayz-hotbar.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "${fabric_loader_range}",
		"minecraft": "${minecraft_range_fabric}",
		"java": "${java_range_fabric}"
	}
}
